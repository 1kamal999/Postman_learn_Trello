    {
      "name": "Get All board",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "afa4c5c8-17f2-44d0-9ce1-29a4edcdf6a5",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "\r",
              "// getting all bord ids \r",
              "all_boards_info=pm.response.json()\r",
              "\r",
              "console.log(all_boards_info)\r",
              "\r",
              "number_of_borads =all_boards_info.length\r",
              "\r",
              "console.log(number_of_borads)\r",
              "\r",
              "board_ids =[]\r",
              "\r",
              "for (i=0; i <number_of_borads;i++ )\r",
              "{\r",
              " console.log(all_boards_info[i].id)\r",
              " board_ids.push(all_boards_info[i].id)\r",
              "}\r",
              "\r",
              "console.log(board_ids)\r",
              "pm.collectionVariables.set(\"all_boards_ids\",board_ids)\r",
              "\r",
              "// Getting data from array using map wgich is optimal then using the loop\r",
              "board_ids = all_boards_info.map(board => board.id)\r",
              "\r",
              "console.log(board_ids)"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
