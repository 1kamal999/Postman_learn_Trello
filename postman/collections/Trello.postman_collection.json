    {
      "name": "Create a board",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "6849364e-fc7c-4d3b-82d5-e28f9a69ed19",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Get Board id and set to collection variable\", function () {\r",
              "\r",
              "    let trello_response = pm.response.json()\r",
              "    pm.collectionVariables.set(\"board_id\", trello_response.id)\r",
              "\r",
              "    pm.expect(trello_response.name).to.eql(\"Learning Postman \" + pm.collectionVariables.get(\"boardNumber\"))\r",
              "    pm.expect(trello_response.closed).to.be.false\r",
              "    pm.expect(trello_response.prefs.permissionLevel).to.eql(\"private\")\r",
              "    pm.expect(trello_response.prefs.switcherViews[2].enabled).to.be.false \r",
              "\r",
              "    // console.log(trello_response.prefs.switcherViews[2].enabled)\r",
              "\r",
              "});\r",
              "\r",
              "\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "id": "ac61bcef-12f0-45f1-98f3-6892ccb0fa8c",
            "exec": [
              "// pm.collectionVariables.set(\"boardNumber\",1);\r",
              "\r",
              "let boardNumber=pm.collectionVariables.get(\"boardNumber\")\r",
              "\r",
              "console.log( (isNaN(boardNumber)))\r",
              "console.log(boardNumber)\r",
              "   // If variable does NOT exist or is not a valid number\r",
              "if (isNaN(boardNumber)){\r",
              "    boardNumber = 0;\r",
              "} \r",
              "boardNumber++\r",
              "    \r",
              "// Store updated value\r",
              "pm.collectionVariables.set(\"boardNumber\", boardNumber);\r",
              "\r",
              "console.log(\"Board Number:\", boardNumber);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
