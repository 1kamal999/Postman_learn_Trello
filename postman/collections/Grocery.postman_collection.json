          "event": [
            {
              "listen": "test",
              "script": {
                "id": "849af64b-2250-4cd3-b118-36f73ffe3354",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "//to check product is avaible in stock 01/23/2026\r",
                  "\r",
                  "pm.test(\"At least one product available.\", function () {\r",
                  "    all_prod_response =pm.response.json()\r",
                  "    //console.log(all_prod_response[0].id)\r",
                  "    //first_prod_id =all_prod_response[0].id\r",
                  "    const product = all_prod_response[0]\r",
                  "    pm.expect(product).to.be.an('object');\r",
                  "    pm.expect(product).to.haveOwnProperty('id')\r",
                  "    pm.expect(product.id).to.be.a('number');\r",
                  "    pm.expect(product).to.haveOwnProperty('inStock')\r",
                  "    pm.expect(product.inStock).to.be.true;\r",
                  "    pm.expect(all_prod_response).to.be.an('array');\r",
                  "    pm.expect(all_prod_response.length).to.be.above(0);\r",
                  "\r",
                  "\r",
                  "\r",
                  "    first_prod_id =product.id\r",
                  "    console.log(product.id)\r",
                  "    pm.environment.set(\"first_prod_id\", first_prod_id)\r",
