        {
          "name": "Get All Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "97211a6e-2b56-43dc-9484-5adcf3d8c468",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Check if Order exist in all_orders_resp using for loop\", function () {",
                  "    all_orders_resp = pm.response.json();",
                  "    last_Order = pm.environment.get(\"OrderId\")",
                  "    console.log(last_Order)",
                  "    Orderexist = false",
                  "    for (var i = 0; i < all_orders_resp.length; i++) {",
                  "        console.log(all_orders_resp[i].id)",
                  "        if (all_orders_resp[i].id === last_Order) {    ",
                  "            Orderexist = true    ",
                  "",
                  "        } ",
                  "    }",
                  "",
                  "    if (Orderexist) {",
                  "        console.log(\"Final result: Order exists in response\");",
                  "    } else {",
                  "        console.log(\"Final result: Order not found in response\");",
                  "    }",
                  "    ",
                  "    console.log(\"Orderexist:\", Orderexist);",
                  "    ",
                  "    pm.expect(Orderexist).to.be.true;",
                  "",
                  "",
                  "});",
                  "",
                  "",
                  "",
                  "pm.test(\"Check if Order exist in all_orders_resp using forEach\", function () {",
                  "    const all_orders_resp = pm.response.json();",
                  "    const last_Order = pm.environment.get(\"OrderId\");",
                  "    ",
                  "    console.log(\"Looking for Order ID:\", last_Order);",
                  "    ",
                  "    let Orderexist = false;",
                  "    ",
                  "    all_orders_resp.forEach((order, index) => {",
                  "        console.log(\"Checking order at index\", index, \"with ID:\", order.id);",
                  "             ",
                  "        if (order.id === last_Order) {    ",
                  "            Orderexist = true;",
                  "            console.log(\"Order found at index\", index);",
                  "        }",
                  "    });",
                  "    ",
                  "    if (Orderexist) {",
                  "        console.log(\"Final result: Order exists in response\");",
                  "    } else {",
                  "        console.log(\"Final result: Order not found in response\");",
                  "    }",
                  "    ",
                  "    console.log(\"Orderexist:\", Orderexist);",
                  "    ",
                  "    pm.expect(Orderexist).to.be.true;",
                  "});",
                  "",
                  "",
                  "",
                  "pm.test(\"Check if Order exist in all_orders_resp using find\", function () {",
                  "",
                  "    const all_orders_resp = pm.response.json();",
                  "    const last_Order = pm.environment.get(\"OrderId\");",
                  "    ",
                  "    console.log(\"Looking for Order ID:\", last_Order);",
                  "    ",
                  "    // let Orderexist = false;",
                  "",
                  "    const foundOrder = all_orders_resp.find(order => order.id === last_Order);",
                  "",
                  "    if (foundOrder) {",
                  "        console.log(\"Final result: Order exists in response\");",
                  "        console.log(foundOrder.id)",
                  "    } else {",
                  "        console.log(\"Final result: Order not found in response\");",
                  "    }",
                  "          ",
                  "    pm.expect(foundOrder).to.be.an('object');",
                  "",
                  "})",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
